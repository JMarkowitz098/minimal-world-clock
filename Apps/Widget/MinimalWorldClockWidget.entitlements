<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the desktop widget. macOS requires widget extensions to be sandboxed. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Shared with the other target so the widget reads the Settings window's choices
	     (WorldClockUI/AppGroup.swift). Team-ID prefix: no provisioning profile needed on macOS. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>Y7W4DC22F6.com.jaredmarkowitz.minimalworldclock</string>
	</array>
</dict>
</plist>
